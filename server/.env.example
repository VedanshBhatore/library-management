# Copy this file to .env and fill in real values. .env is git-ignored.

# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/library_management?schema=public"

# Secret used to sign JWTs. Use a long random string in real deployments.
JWT_SECRET="replace-with-a-long-random-string"

# Port the Express server listens on.
PORT=4000

# Origin of the Vite dev server, for CORS.
CLIENT_ORIGIN="http://localhost:5173"
